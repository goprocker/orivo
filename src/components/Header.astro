---
const navItems = [
  { label: "Services", href: "/services" },
  { label: "Work", href: "/work" },
  { label: "About", href: "/about" },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="OVIRO home">OVIRO<span aria-hidden="true">.</span></a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <a class="header-cta" href="/contact">Start a project <span aria-hidden="true">↗</span></a>

  <details class="mobile-menu">
    <summary aria-label="Open navigation">
      <span>Menu</span>
      <span class="menu-icon" aria-hidden="true"></span>
    </summary>
    <nav aria-label="Mobile navigation">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/contact">Start a project</a>
    </nav>
  </details>
</header>

<style>
  .site-header {
    align-items: center;
    display: grid;
    grid-template-columns: 1fr auto;
    min-height: 5.5rem;
    padding: 0 var(--page-pad);
    position: relative;
    z-index: 20;
  }

  .wordmark {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
    text-decoration: none;
  }

  .wordmark span {
    color: var(--signal);
  }

  .desktop-nav,
  .header-cta {
    display: none;
  }

  .mobile-menu summary {
    align-items: center;
    cursor: pointer;
    display: flex;
    font-size: 0.78rem;
    font-weight: 700;
    gap: 0.75rem;
    justify-content: center;
    letter-spacing: 0.08em;
    min-height: 2.75rem;
    text-transform: uppercase;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-icon,
  .menu-icon::after {
    background: currentColor;
    content: "";
    display: block;
    height: 1px;
    transition: transform 180ms ease;
    width: 1.25rem;
  }

  .menu-icon::after {
    transform: translateY(0.35rem);
  }

  .mobile-menu[open] .menu-icon {
    transform: translateY(0.175rem) rotate(45deg);
  }

  .mobile-menu[open] .menu-icon::after {
    transform: rotate(-90deg);
  }

  .mobile-menu nav {
    background: var(--ink);
    display: grid;
    inset: 5.5rem 0 auto;
    padding: 1.25rem var(--page-pad) 2rem;
    position: absolute;
  }

  .mobile-menu nav a {
    border-bottom: 1px solid rgba(246, 241, 232, 0.2);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: clamp(2rem, 10vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    min-height: 4.25rem;
    padding: 0.6rem 0;
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .site-header {
      grid-template-columns: 1fr auto 1fr;
    }

    .desktop-nav {
      display: flex;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }

    .desktop-nav a,
    .header-cta {
      color: var(--ink);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.07em;
      min-height: 2.75rem;
      text-decoration: none;
      text-transform: uppercase;
    }

    .desktop-nav a {
      align-items: center;
      display: flex;
      position: relative;
    }

    .desktop-nav a::after {
      background: var(--signal);
      bottom: 0.55rem;
      content: "";
      height: 2px;
      left: 0;
      position: absolute;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 180ms ease;
      width: 100%;
    }

    .desktop-nav a:hover::after,
    .desktop-nav a:focus-visible::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .header-cta {
      align-items: center;
      display: flex;
      gap: 0.5rem;
      justify-self: end;
    }

    .header-cta span {
      color: var(--signal);
      font-size: 1rem;
    }

    .mobile-menu {
      display: none;
    }
  }
</style>
