---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact — ORVIO" description="Start a social media project with ORVIO.">
  <div id="top" class="page-shell">
    <Header />
    <main>
      <section class="contact-page section-pad" aria-labelledby="contact-title">
        <p class="eyebrow">Start a project</p>
        <h1 id="contact-title">Let’s make<br /><em>some noise.</em></h1>
        <div class="contact-grid">
          <div>
            <p class="contact-lead">Tell us what the brand needs to change on social. We’ll start from there.</p>
            <div class="contact-status">
              <span><i aria-hidden="true"></i> Inquiry channel</span>
              <strong>Official contact details coming soon.</strong>
              <p>ORVIO’s email and social links will be connected before launch.</p>
            </div>
          </div>
          <div class="brief-list">
            <p>Useful things to bring</p>
            <ol>
              <li><span>01</span>What should social change for the brand?</li>
              <li><span>02</span>Who are we trying to reach?</li>
              <li><span>03</span>What is working or missing today?</li>
              <li><span>04</span>When does the work need to move?</li>
            </ol>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
