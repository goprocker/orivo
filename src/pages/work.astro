---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Work — ORVIO" description="Selected social media work from ORVIO.">
  <div id="top" class="page-shell">
    <Header />
    <main>
      <section class="inner-hero inner-hero--dark">
        <p class="eyebrow eyebrow-light">Work / Archive</p>
        <h1>Made to be<br /><em>remembered.</em></h1>
        <p class="inner-hero__intro">We only publish real work with approved details. The first ORVIO case studies are being prepared.</p>
      </section>

      <section class="archive-empty section-pad" aria-labelledby="archive-title">
        <div class="archive-index"><span>001</span><span>Coming soon</span></div>
        <div class="archive-poster">
          <span>THE WORK<br />IS LOADING</span>
          <i aria-hidden="true"></i>
        </div>
        <div class="archive-copy">
          <h2 id="archive-title">Proof over placeholders.</h2>
          <p>Client names, campaign details, visuals, and outcomes will appear here only after they are supplied and approved.</p>
          <a class="text-link" href="/contact">Talk about your project <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
