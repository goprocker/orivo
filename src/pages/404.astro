---
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — OVIRO" description="The requested page could not be found.">
  <div id="top" class="page-shell error-shell">
    <Header />
    <main class="not-found" aria-labelledby="not-found-title">
      <div class="not-found__code" aria-hidden="true">404</div>
      <p class="eyebrow">Wrong turn / Right energy</p>
      <h1 id="not-found-title">This page left<br /><em>the feed.</em></h1>
      <p>The link may be old, mistyped, or no longer available.</p>
      <a class="hero-cta" href="/">Back to OVIRO <span aria-hidden="true">↗</span></a>
    </main>
  </div>
</BaseLayout>
