---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  ["01", "Social strategy", "Find the position, audience, and rhythm your brand can own."],
  ["02", "Content systems", "Build a recognisable stream of ideas instead of isolated posts."],
  ["03", "Campaign creative", "Turn a brief into a social idea designed to travel."],
  ["04", "Community & growth", "Create reasons for people to join, respond, and return."],
];
---

<BaseLayout
  title="ORVIO — Stop the scroll"
  description="ORVIO is a social media agency creating strategy, content, campaigns, and communities built for the feed."
>
  <div id="top" class="page-shell">
    <Header />

    <main>
      <section class="social-hero" aria-labelledby="hero-title">
        <div class="social-hero__meta reveal reveal-1">
          <span><i aria-hidden="true"></i> Social-first creative agency</span>
          <span>Built for the feed</span>
        </div>

        <h1 id="hero-title" class="social-hero__title reveal reveal-2">
          <span>Stop the</span>
          <span class="outline-word">scroll.</span>
        </h1>

        <div class="feed-stack" aria-hidden="true">
          <div class="feed-card feed-card--one">
            <span>01 / Strategy</span>
            <strong>BE<br />SEEN.</strong>
          </div>
          <div class="feed-card feed-card--two">
            <span>02 / Content</span>
            <div class="pulse-ring"></div>
            <strong>STAY<br />RELEVANT.</strong>
          </div>
          <div class="feed-card feed-card--three">
            <span>03 / Culture</span>
            <strong>MOVE<br />PEOPLE.</strong>
          </div>
        </div>

        <div class="social-hero__bottom reveal reveal-3">
          <p>We turn brands into ideas people pause for, talk about, and remember.</p>
          <a class="hero-cta" href="/contact">
            Make some noise
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="scroll-cue" aria-hidden="true"><span>Scroll to enter</span><i></i></div>
      </section>

      <section class="manifesto section-pad" aria-labelledby="manifesto-title">
        <p class="eyebrow">The feed moves fast. So do we.</p>
        <h2 id="manifesto-title">
          Your brand does not need <em>more posts.</em><br />
          It needs a reason to be followed.
        </h2>
        <div class="manifesto-foot">
          <p>ORVIO brings strategy, creative, and community into one social system with a clear point of view.</p>
          <a class="text-link" href="/about">Why ORVIO <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="culture-strip" aria-label="ORVIO creative principles">
        <div class="culture-tile culture-tile--orange"><span>Think social.</span><b>01</b></div>
        <div class="culture-tile culture-tile--dark"><span>Move fast.</span><b>02</b></div>
        <div class="culture-tile culture-tile--lime"><span>Make culture.</span><b>03</b></div>
      </section>

      <section class="home-services section-pad" aria-labelledby="services-title">
        <div class="section-head">
          <p class="eyebrow">What we do</p>
          <h2 id="services-title">Built for<br /><span>social motion.</span></h2>
          <p class="section-intro">From the first insight to the daily conversation, we shape how a brand lives on social.</p>
        </div>

        <div class="service-list">
          {services.map(([number, title, description]) => (
            <a class="service-row service-link" href="/services">
              <span class="service-number">{number}</span>
              <div>
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
              <span class="service-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="work-callout section-pad" aria-labelledby="work-title">
        <p class="eyebrow eyebrow-light">Selected work</p>
        <div class="work-callout__grid">
          <div>
            <h2 id="work-title">No fake flex.</h2>
            <p>Real project stories will appear after client approval. Until then, we keep the proof honest.</p>
            <a class="text-link text-link--light" href="/work">Visit work archive <span aria-hidden="true">↗</span></a>
          </div>
          <div class="work-poster" aria-label="ORVIO work archive coming soon">
            <span>ORVIO / WORK</span>
            <strong>COMING<br />IN HOT.</strong>
            <i>Archive 001</i>
          </div>
        </div>
      </section>

      <section class="final-cta section-pad" aria-labelledby="cta-title">
        <p class="eyebrow">Your move</p>
        <h2 id="cta-title">Ready to make<br /><em>social matter?</em></h2>
        <a class="circle-link circle-link--large" href="/contact">
          <span>Start a<br />project</span><span class="arrow" aria-hidden="true">↗</span>
        </a>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
